{
  "name": "rs-tasklocked",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "schema": "tsx scripts/apply-schema.ts",
    "seed": "tsx scripts/seed-tasks.ts",
    "set-code": "tsx scripts/set-code.ts",
    "set-sync-secret": "tsx scripts/set-sync-secret.ts",
    "worker:dev": "npx wrangler dev",
    "worker:deploy": "npx wrangler deploy",
    "worker:log": "npx wrangler tail",
    "reset": "tsx scripts/reset.ts",
    "verify": "tsx scripts/verify-rules.ts",
    "upgrade": "npx npm-check-updates -u && npm install"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "dotenv": "^17.4.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
