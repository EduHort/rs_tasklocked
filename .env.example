# Copie para .env.local e preencha. O .env.local esta no .gitignore.
#
# Onde achar cada coisa no painel do Supabase:
#   URL   -> botao "Connect" no topo, ou Project Settings > Data API > Project URL
#            (tambem da para montar: https://<ref>.supabase.co, com o <ref> da
#             barra de endereco em /dashboard/project/<ref>)
#   keys  -> Project Settings > API Keys

# --- O site precisa destas duas. Sao as mesmas que vao no Cloudflare Pages. ---
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# "publishable key" no painel novo (sb_publishable_...), ou "anon key" no antigo.
# Vai para o bundle de proposito: a RLS bloqueia acesso direto as tabelas.
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# --- Esta e so para os scripts locais (npm run seed / set-code / verify). ---
# "secret key" no painel novo (sb_secret_...), ou "service_role key" no antigo.
# NUNCA coloque no Cloudflare: ela ignora a RLS.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- Esta e so para o `npm run schema`, que aplica o supabase/schema.sql. ---
# Project Settings > Connect, na aba superior, e escolha "Session pooler".
#
# Tem que ser o SESSION pooler, pelos dois motivos:
#   - a "Direct connection" (db.<ref>.supabase.co) e IPv6-only desde que o
#     Supabase tirou o IPv4 do free tier. Em rede so-IPv4 ela nem conecta.
#   - o "Transaction pooler" (porta 6543) nao aceita o DDL do schema.
#
# Repare que o usuario vira postgres.<ref>, nao postgres.
# A senha e a do BANCO (Database > Database password), nao a service_role key;
# da para resetar ali sem afetar as keys nem o site no ar. Se ela tiver
# caractere especial (@ / : # ?), precisa vir percent-encoded na URI.
#
# Sem esta variavel, da para colar o schema.sql no SQL Editor do painel.
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
