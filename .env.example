# Copie para .env.local e preencha. O .env.local esta no .gitignore.
#
# Onde achar cada coisa no painel do Supabase:
#   URL   -> botao "Connect" no topo, ou Project Settings > Data API > Project URL
#            (tambem da para montar: https://<ref>.supabase.co, com o <ref> da
#             barra de endereco em /dashboard/project/<ref>)
#   keys  -> Project Settings > API Keys

# --- O site precisa destas duas. Sao as mesmas que vao no Cloudflare Pages. ---
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# "publishable key" no painel novo (sb_publishable_...), ou "anon key" no antigo.
# Vai para o bundle de proposito: a RLS bloqueia acesso direto as tabelas.
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# --- Esta e so para os scripts locais (npm run seed / set-code / verify). ---
# "secret key" no painel novo (sb_secret_...), ou "service_role key" no antigo.
# NUNCA coloque no Cloudflare: ela ignora a RLS.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
